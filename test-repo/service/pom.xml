<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.example.wizdemo</groupId>
    <artifactId>wiz-demo-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>service</artifactId>

  <dependencies>
    <!-- sibling module: its dependencies are api's direct dependencies, not ours -->
    <dependency>
      <groupId>com.example.wizdemo</groupId>
      <artifactId>api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- literal version overriding the parent's management (CISA KEV) -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
      <version>2.14.1</version>
    </dependency>
    <!-- property defined only by the external parent -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>${snakeyaml.version}</version>
    </dependency>
    <!-- brings vulnerable TRANSITIVE dependencies (spring-web, tomcat-embed-core): not listed -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- test scope, literal version -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>1.4.200</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
